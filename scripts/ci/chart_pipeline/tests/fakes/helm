#!/usr/bin/env python3

from __future__ import annotations

import hashlib
import os
import shutil
import subprocess
import sys
from pathlib import Path


def chart_identity(real_helm: str, archive: str) -> tuple[str, str]:
    result = subprocess.run(
        [real_helm, "show", "chart", archive],
        stdout=subprocess.PIPE,
        text=True,
        check=True,
    )
    fields: dict[str, str] = {}
    for line in result.stdout.splitlines():
        if line.startswith("name:") or line.startswith("version:"):
            key, value = line.split(":", 1)
            fields[key] = value.strip().strip("'\"")
    return fields["name"], fields["version"]


message = os.environ.get("FAKE_HELM_STDERR_MESSAGE")
if message:
    print(message, file=sys.stderr)

real_helm = os.environ["REAL_HELM"]
command = sys.argv[1] if len(sys.argv) > 1 else ""
arguments = sys.argv[2:]

if command in ("show", "package"):
    if command == "show" and os.environ.get("FAKE_HELM_SHOW_STDOUT_NOISE"):
        print(os.environ["FAKE_HELM_SHOW_STDOUT_NOISE"], flush=True)
    os.execv(real_helm, [real_helm, command, *arguments])

registry = Path(os.environ["FAKE_REGISTRY"])
if command == "pull":
    forced_error = os.environ.get("FAKE_HELM_PULL_ERROR")
    if forced_error:
        print(f"Error: {forced_error}", file=sys.stderr)
        sys.exit(1)

    reference = arguments[0]
    version = ""
    destination = Path(".")
    index = 1
    while index < len(arguments):
        if arguments[index] == "--version":
            version = arguments[index + 1]
            index += 2
        elif arguments[index] == "--destination":
            destination = Path(arguments[index + 1])
            index += 2
        else:
            index += 1

    name = reference.rsplit("/", 1)[-1]
    chart_directory = registry / name
    source_archive = chart_directory / f"{version}.tgz"
    push_marker = chart_directory / ".pushed"
    failure_limit = int(os.environ.get("FAKE_HELM_POST_PUSH_PULL_FAILURES", "0"))
    failure_count_file = chart_directory / ".post-push-pull-count"
    failure_count = (
        int(failure_count_file.read_text(encoding="utf-8"))
        if failure_count_file.exists()
        else 0
    )
    if push_marker.exists() and failure_count < failure_limit:
        failure_count_file.write_text(str(failure_count + 1), encoding="utf-8")
        print("Error: temporary registry failure", file=sys.stderr)
        sys.exit(1)
    if not source_archive.is_file():
        print(
            f"Error: manifest unknown: {name}:{version} not found",
            file=sys.stderr,
        )
        sys.exit(1)

    destination.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source_archive, destination / f"{name}-{version}.tgz")
    print(f"Pulled: {reference}:{version}")
elif command == "push":
    archive, destination = arguments
    name, version = chart_identity(real_helm, archive)
    chart_directory = registry / name
    chart_directory.mkdir(parents=True, exist_ok=True)
    if os.environ.get("FAKE_HELM_PUSH_MODE", "copy") != "noop":
        shutil.copy2(archive, chart_directory / f"{version}.tgz")
    (chart_directory / ".pushed").touch()
    digest = hashlib.sha256(Path(archive).read_bytes()).hexdigest()
    print(f"Pushed: {destination}/{name}:{version}", file=sys.stderr)
    print(f"Digest: sha256:{digest}", file=sys.stderr)
else:
    os.execv(real_helm, [real_helm, command, *arguments])
